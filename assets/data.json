    "exercises": [
        {
            "id": "ex_sqt",
            "title": {
                "en": "Barbell Back Squat",
                "ar": "باربيل باك سكوات"
            },
            "video_url": "https://storage.googleapis.com/fitflow-vids/squat.mp4",
            "form_cues": {
                "en": [
                    "Keep chest up",
                    "Drive through mid-foot",
                    "Break at hips and knees"
                ],
                "ar": [
                    "حافظ على استقامة صدرك",
                    "ادفع بمنتصف قدمك",
                    "اثنِ وركك وركبتيك معاً"
                ]
            }
        },
        {
            "id": "ex_dl",
            "title": {
                "en": "Deadlift",
                "ar": "ديدليفت"
            },
            "video_url": "https://storage.googleapis.com/fitflow-vids/deadlift.mp4",
            "form_cues": {
                "en": [
                    "Keep back flat",
                    "Hinge at the hips",
                    "Bar stays close to legs"
                ],
                "ar": [
                    "حافظ على استقامة ظهرك",
                    "ادفع من الورك للخلف",
                    "اجعل البار قريباً من قدميك"
                ]
            }
        },
        {
            "id": "ex_bnc",
            "title": {
                "en": "Barbell Bench Press",
                "ar": "باربيل بنش برس"
            },
            "video_url": "https://storage.googleapis.com/fitflow-vids/bench.mp4",
            "form_cues": {
                "en": [
                    "Retract scapula",
                    "Plant feet firmly",
                    "Lower bar to mid-chest"
                ],
                "ar": [
                    "اسحب لوحي كتفك للخلف",
                    "ثبت قدميك بقوة على الأرض",
                    "أنزل البار إلى منتصف الصدر"
                ]
            }
        },
        {
            "id": "ex_ohp",
            "title": {
                "en": "Overhead Press",
                "ar": "أوفر هيد برس"
            },
            "video_url": "https://storage.googleapis.com/fitflow-vids/ohp.mp4",
            "form_cues": {
                "en": [
                    "Brace core tightly",
                    "Squeeze glutes",
                    "Press in a straight line"
                ],
                "ar": [
                    "شد عضلات بطنك بقوة",
                    "اقبض عضلات المؤخرة",
                    "ادفع البار في خط مستقيم لأعلى"
                ]
            }
        },
        {
            "id": "ex_row",
            "title": {
                "en": "Barbell Row",
                "ar": "باربيل رو"
            },
            "video_url": "https://storage.googleapis.com/fitflow-vids/row.mp4",
            "form_cues": {
                "en": [
                    "Keep back parallel to floor",
                    "Pull to lower stomach",
                    "Squeeze shoulder blades"
                ],
                "ar": [
                    "اجعل ظهرك موازياً للأرض",
                    "اسحب البار لأسفل البطن",
                    "اعصر لوحي كتفك معاً"
                ]
            }
        },
        {
            "id": "ex_pup",
            "title": {
                "en": "Pull-Ups",
                "ar": "بول أبس (عقلة)"
            },
            "video_url": "https://storage.googleapis.com/fitflow-vids/pullup.mp4",
            "form_cues": {
                "en": [
                    "Start from dead hang",
                    "Pull chin over bar",
                    "Control the descent"
                ],
                "ar": [
                    "ابدأ من التعلق الكامل",
                    "اسحب حتى تتخطى ذقنك البار",
                    "تحكم في النزول ببطء"
                ]
            }
        },
        {
            "id": "ex_psh",
            "title": {
                "en": "Push-Ups",
                "ar": "بوش أبس (ضغط)"
            },
            "video_url": "https://storage.googleapis.com/fitflow-vids/pushup.mp4",
            "form_cues": {
                "en": [
                    "Body in straight line",
                    "Chest to floor",
                    "Elbows at 45 degrees"
                ],
                "ar": [
                    "اجعل جسمك في خط مستقيم",
                    "انزل حتى يلامس صدرك الأرض",
                    "اجعل المرفقين بزاوية 45 درجة"
                ]
            }
        },
        {
            "id": "ex_lng",
            "title": {
                "en": "Walking Lunges",
                "ar": "ووكينج لانجز"
            },
            "video_url": "https://storage.googleapis.com/fitflow-vids/lunge.mp4",
            "form_cues": {
                "en": [
                    "Keep torso upright",
                    "Back knee hovers above floor",
                    "Push off front heel"
                ],
                "ar": [
                    "حافظ على استقامة جذعك",
                    "الركبة الخلفية تقترب من الأرض",
                    "ادفع بكعب القدم الأمامية"
                ]
            }
        },
        {
            "id": "ex_plk",
            "title": {
                "en": "Forearm Plank",
                "ar": "فورآرم بلانك"
            },
            "video_url": "https://storage.googleapis.com/fitflow-vids/plank.mp4",
            "form_cues": {
                "en": [
                    "Hollow out stomach",
                    "Squeeze glutes",
                    "Keep hips level"
                ],
                "ar": [
                    "شد عضلات البطن للداخل",
                    "اقبض عضلات المؤخرة",
                    "حافظ على مستوى حوضك"
                ]
            }
        },
        {
            "id": "ex_jck",
            "title": {
                "en": "Jumping Jacks",
                "ar": "جامبينج جاكس"
            },
            "video_url": "https://storage.googleapis.com/fitflow-vids/jacks.mp4",
            "form_cues": {
                "en": [
                    "Stay light on feet",
                    "Full range of motion with arms"
                ],
                "ar": [
                    "ابق خفيفاً على قدميك",
                    "مد ذراعيك بالكامل أثناء الحركة"
                ]
            }
        },
        {
            "id": "ex_brp",
            "title": {
                "en": "Burpees",
                "ar": "بيربيز"
            },
            "video_url": "https://storage.googleapis.com/fitflow-vids/burpee.mp4",
            "form_cues": {
                "en": [
                    "Drop chest to floor",
                    "Explosive jump up",
                    "Clap hands overhead"
                ],
                "ar": [
                    "انزل بصدرك للأرض",
                    "اقفز بقوة لأعلى",
                    "صفق بيديك فوق رأسك"
                ]
            }
        },
        {
            "id": "ex_bic",
            "title": {
                "en": "Dumbbell Bicep Curl",
                "ar": "دمبل بايسيبس كيرل"
            },
            "video_url": "https://storage.googleapis.com/fitflow-vids/curl.mp4",
            "form_cues": {
                "en": [
                    "Keep elbows pinned to sides",
                    "Squeeze at the top",
                    "Slow eccentric"
                ],
                "ar": [
                    "ثبت مرفقيك بجانبك",
                    "اعصر العضلة في الأعلى",
                    "انزل بالوزن ببطء"
                ]
            }
        },
        {
            "id": "ex_tri",
            "title": {
                "en": "Tricep Pushdown",
                "ar": "ترايسبس بوش داون"
            },
            "video_url": "https://storage.googleapis.com/fitflow-vids/tricep.mp4",
            "form_cues": {
                "en": [
                    "Keep chest proud",
                    "Elbows locked in place",
                    "Fully extend arms"
                ],
                "ar": [
                    "ارفع صدرك للأعلى",
                    "ثبت مرفقيك في مكانهما",
                    "افرد ذراعيك بالكامل لأسفل"
                ]
            }
        },
        {
            "id": "ex_clf",
            "title": {
                "en": "Standing Calf Raise",
                "ar": "ستاندينج كالف ريز"
            },
            "video_url": "https://storage.googleapis.com/fitflow-vids/calf.mp4",
            "form_cues": {
                "en": [
                    "Stretch fully at bottom",
                    "Hold contraction at top for 1 second"
                ],
                "ar": [
                    "انزل للأسفل للإطالة الكاملة",
                    "اثبت في الأعلى لثانية واحدة"
                ]
            }
        }
